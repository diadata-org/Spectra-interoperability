# Attestor Service Configuration

# RPC Configuration
rpc:
  url: https://testnet-rpc.diadata.org
  registry_url: https://testnet-rpc.diadata.org

# Oracle Configuration
oracle:
  address: "0x0087342f5f4c7AB23a37c045c3EF710749527c88"

# Registry Configuration
registry:
  address: ""  # Set your intent registry contract address

# Attestor Configuration
attestor:
  private_key: ""  # Set your private key (or use ATTESTOR_PRIVATE_KEY env var)
  symbols:
    - BTC/USD
    - ETH/USD
  polling_time: 300ms
  batch_mode: true

# Logging Configuration
logging:
  level: info

# Metrics Configuration
metrics:
  port: 8080

# API Server Configuration
api:
  port: 8081

# Environment Variable Override
# You can override any configuration value using environment variables:
# - ATTESTOR_RPC_URL
# - ATTESTOR_ORACLE_ADDRESS
# - ATTESTOR_REGISTRY_ADDRESS
# - ATTESTOR_ATTESTOR_PRIVATE_KEY
# - ATTESTOR_ATTESTOR_SYMBOLS (comma-separated)
# - ATTESTOR_ATTESTOR_POLLING_TIME
# - ATTESTOR_LOGGING_LEVEL
# - ATTESTOR_METRICS_PORT
# - ATTESTOR_API_PORT
#
# For backward compatibility, these environment variables are also supported:
# - RPC_URL
# - ORACLE_ADDRESS
# - INTENT_REGISTRY_ADDRESS
# - PRIVATE_KEY
# - SYMBOLS (comma-separated)
# - POLLING_TIME (in seconds)
# - LOG_LEVEL
# - METRICS_PORT
# - L2_RPC_URL (maps to rpc.registry_url)